APP_MODE=demo
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_SECURE=false
CLICKHOUSE_DATABASE=wrapcheck
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=wrapcheck-local
CLICKHOUSE_CONNECT_TIMEOUT=3
CLICKHOUSE_RECEIVE_TIMEOUT=10
CLICKHOUSE_MCP_PASSWORD=wrapcheck-mcp-local
CLICKHOUSE_MCP_URL=http://clickhouse-mcp:8000/mcp
# Set this to the private Cloud Run MCP service URL in live mode. Leave blank locally.
CLICKHOUSE_MCP_AUDIENCE=
CORS_ORIGINS=http://localhost:3000

# Live media-handoff mode: use Application Default Credentials; never paste service-account JSON here.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
DEMO_QUOTA_SECRET=
DEMO_RUNS_PER_10_MINUTES=3
UPLOAD_DELIVERIES_PER_10_MINUTES=3
GLOBAL_RUNS_PER_10_MINUTES=100
CURATED_MEDIA_BUCKET=
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_SERVICE_ACCOUNT=
CLOUD_RUN_BACKEND_URL=
# Used only with compose.live.yaml; set to an absolute host path.
GOOGLE_APPLICATION_CREDENTIALS_FILE=
